{
  // Name shown in the VS Code title bar. Defaults to the project folder name.
  "name": "${localWorkspaceFolderBasename}",

  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",

  "remoteUser": "node",

  // Must match the workspace mount in docker-compose.yml, which uses
  // COMPOSE_PROJECT_NAME from the `.env` file next to it. Keep the value in
  // `.env` equal to your project folder name (see `.env.example`).
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "containerEnv": {
    // Essential locale and timezone settings. Change but DO NOT REMOVE.
    // Without these, you WILL get really weird encoding and date/time problems.
    //
    // `${localEnv:VAR:fallback}` forwards VAR from your host machine and uses
    // the value after the last colon when the variable is unset there.
    "TZ": "${localEnv:TZ:America/Sao_Paulo}",
    "LC_ALL": "${localEnv:LC_ALL:C.UTF-8}",
    "LANG": "${localEnv:LANG:C.UTF-8}"
  },

  // Optional extra tooling (oh-my-zsh, fzf, dotfiles shell init). Review the
  // script first at https://devmagic.run/setup, then uncomment to enable:
  // "postCreateCommand": "curl -fsSL https://devmagic.run/setup | bash",

  // Dev Container Features add tools on top of the image built from the
  // Dockerfile. Browse the catalog at https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}

    // Uncomment to run containers (including the auxiliary services in
    // docker-compose.yml) from a terminal inside the dev container:
    // "ghcr.io/devcontainers/features/docker-in-docker:2": {},

    // If your workflow uses Git LFS:
    // "ghcr.io/devcontainers/features/git-lfs:1": { "autoPull": false },
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // AI assistants.
        "anthropic.claude-code",
        "github.copilot",
        "github.copilot-chat",

        // Git.
        "eamodio.gitlens",

        // Language and formatting basics.
        "dbaeumer.vscode-eslint",
        "editorconfig.editorconfig",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml"
      ]
    }
  }
}
