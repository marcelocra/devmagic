# Docker Compose reads this file when it lives next to docker-compose.yml.
# Copy it to `.env` (the DevMagic installer does this for you).
#
# IMPORTANT: COMPOSE_PROJECT_NAME must match your project folder name, because
# devcontainer.json mounts the workspace at
# /workspaces/${localWorkspaceFolderBasename} and docker-compose.yml uses this
# value for the same path. It also names the Compose project, the container
# hostname, and the built image tag.
#
# Allowed characters: lowercase letters, digits, dashes and underscores.
COMPOSE_PROJECT_NAME=devmagic
