# Docker Compose reads a `.env` file placed next to docker-compose.yml.
# The DevMagic installer generates `.env` for you; to set things up manually,
# copy this file: `cp .env.example .env`.
#
# This file is the reference for every value that must stay in sync across
# the devcontainer files. It is consumed in two ways:
#   1. Docker Compose interpolates ${VARS} in docker-compose.yml from it.
#   2. The dev service loads it via `env_file`, so the values are also
#      available as environment variables inside the container.
# Note that devcontainer.json CANNOT read this file: its `${localEnv:VAR}`
# syntax reads your HOST environment variables, so any value shared with
# devcontainer.json is matched by convention, as documented per variable
# below.

# ------------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME
#
# Used by docker-compose.yml for:
#   - the Compose project name (`name:`)
#   - the workspace mount path and working dir (/workspaces/<value>)
#   - the container hostname and the built image tag
#
# Must match (by convention): your project FOLDER NAME, because
# devcontainer.json sets `workspaceFolder` to
# /workspaces/${localWorkspaceFolderBasename}. If the folder name isn't a
# valid Compose project name (spaces, uppercase, ...), pin `workspaceFolder`
# to /workspaces/<value> instead — the installer does this automatically.
#
# Allowed characters: lowercase letters, digits, dashes and underscores.
COMPOSE_PROJECT_NAME=devmagic

# ------------------------------------------------------------------------------
# DEVMAGIC_DB_PASSWORD (optional)
#
# Password for example database services in docker-compose.yml. Only relevant
# if you enable one of them.
# DEVMAGIC_DB_PASSWORD=change-me
