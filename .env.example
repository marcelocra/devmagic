# DevMagic Setup Configuration
# Copy this file to .env and customize as needed:
#   cp .devcontainer/.env.example .devcontainer/.env
#
# These variables control the setup script behavior during container creation.

# Install zsh plugins (powerlevel10k, syntax highlighting, autosuggestions)
MCRA_SETUP_ZSH_PLUGINS=true

# Clone and setup dotfiles from your repository
MCRA_SETUP_DOTFILES=true

# Use mise (formerly rtx) for runtime version management
MCRA_USE_MISE=false

# Setup editor launcher (code command, etc.)
MCRA_SETUP_EDITOR_LAUNCHER=true

# Install system packages (build-essential, etc.)
MCRA_SETUP_SYSTEM_PACKAGES=true

# Install pnpm package manager
MCRA_SETUP_PNPM=true

# Quick mode - skip optional/slow setup steps
MCRA_QUICK=false

# Interactive mode - prompt for confirmations
MCRA_INTERACTIVE=false
