---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
---

<BaseLayout
  title="Getting Started - DevMagic"
  description="Get started with DevMagic in three different ways: standalone, consumer, or maintainer mode."
>
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold mb-4">Getting Started</h1>
      <p class="text-xl text-muted-foreground mb-8">
        DevMagic can be used in three different ways. Choose the one that fits your workflow.
      </p>

      <!-- Prerequisites -->
      <section class="mb-12 bg-muted/50 rounded-lg p-6">
        <h2 class="text-2xl font-bold mb-4">Prerequisites (All Modes)</h2>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-6 h-6 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <div>
              <strong>Container Runtime:</strong> Install <a href="https://podman-desktop.io" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Podman Desktop</a> or Docker
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-6 h-6 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <div>
              <strong>Editor:</strong> Install <a href="https://code.visualstudio.com/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Visual Studio Code</a> (or any Dev Container compatible editor)
            </div>
          </li>
        </ul>
      </section>

      <!-- Mode Selection -->
      <div class="mb-8">
        <div class="flex flex-col sm:flex-row gap-2 mb-8 border-b border-border">
          <button
            class="tab-button px-4 py-2 font-medium transition-colors border-b-2 border-transparent hover:text-foreground active"
            data-tab="standalone"
          >
            Standalone
          </button>
          <button
            class="tab-button px-4 py-2 font-medium transition-colors border-b-2 border-transparent hover:text-foreground"
            data-tab="consumer"
          >
            Consumer
          </button>
          <button
            class="tab-button px-4 py-2 font-medium transition-colors border-b-2 border-transparent hover:text-foreground"
            data-tab="maintainer"
          >
            Maintainer
          </button>
        </div>

        <!-- Standalone Tab -->
        <div class="tab-content" data-content="standalone">
          <div class="bg-card border border-border rounded-lg p-8">
            <div class="mb-6">
              <h2 class="text-3xl font-bold mb-3">Standalone Mode</h2>
              <p class="text-lg text-muted-foreground">
                Use DevMagic directly as a portable development environment. Perfect for:
              </p>
              <ul class="mt-3 space-y-2 text-muted-foreground">
                <li class="flex items-start gap-2">
                  <span class="text-primary">•</span>
                  Fresh OS installations
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary">•</span>
                  Temporary/throw-away workspaces
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary">•</span>
                  Not wanting to install dev tools on your host
                </li>
              </ul>
            </div>

            <div class="space-y-6">
              <div>
                <h3 class="text-xl font-semibold mb-3">Step 1: Clone the Repository</h3>
                <CodeBlock
                  code={`git clone https://github.com/marcelocra/devmagic.git
cd devmagic`}
                />
                <p class="mt-2 text-sm text-muted-foreground">
                  💡 Don't have git installed? Download as a ZIP from GitHub - the environment provides Git.
                </p>
              </div>

              <div>
                <h3 class="text-xl font-semibold mb-3">Step 2: Open in VS Code</h3>
                <p class="mb-2">
                  Open the folder in VS Code and choose <strong>"Reopen in Container"</strong> when prompted.
                </p>
                <p class="text-sm text-muted-foreground">
                  You now have a fully featured dev environment without installing anything else on the host system.
                </p>
              </div>

              <div>
                <h3 class="text-xl font-semibold mb-3">Step 3: Use as Your Dev Terminal</h3>
                <p class="mb-2">
                  Use this repo as a personal dev terminal/workstation. When you need to work on another project:
                </p>
                <CodeBlock
                  code={`git clone https://github.com/other/repo.git
cd repo
code .`}
                />
                <p class="mt-2 text-sm text-muted-foreground">
                  Each cloned repo automatically uses the same dev container setup, making DevMagic a portable coding box you can carry between machines.
                </p>
              </div>

              <div class="bg-muted/50 rounded-lg p-4 mt-6">
                <h4 class="font-semibold mb-2">Important Note</h4>
                <p class="text-sm text-muted-foreground">
                  Each image might have a different default user. Check the <code>remoteUser</code> setting in <code>.devcontainer/devcontainer.json</code> and adjust any paths that depend on the user (like volume mounts).
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Consumer Tab -->
        <div class="tab-content hidden" data-content="consumer">
          <div class="bg-card border border-border rounded-lg p-8">
            <div class="mb-6">
              <h2 class="text-3xl font-bold mb-3">Consumer Mode</h2>
              <p class="text-lg text-muted-foreground">
                Embed DevMagic as a Git submodule in your projects to provide instant, consistent development environments for all contributors.
              </p>
            </div>

            <div class="space-y-6">
              <div>
                <h3 class="text-xl font-semibold mb-3">Step 1: Add as Submodule</h3>
                <p class="mb-2">
                  From your project root, add DevMagic as a submodule at <code>.devcontainer/</code>:
                </p>
                <CodeBlock
                  code="git submodule add https://github.com/marcelocra/devmagic.git .devcontainer"
                />
              </div>

              <div>
                <h3 class="text-xl font-semibold mb-3">Step 2: Project Structure</h3>
                <p class="mb-2">Your project will now have:</p>
                <CodeBlock
                  code={`your-project/
└── .devcontainer/        ← submodule
    ├── devcontainer.json
    ├── docker-compose.yml
    └── ...`}
                  lang="plaintext"
                />
              </div>

              <div>
                <h3 class="text-xl font-semibold mb-3">Step 3: Use the Environment</h3>
                <p class="mb-2">
                  Open your project in VS Code and select <strong>"Reopen in Container"</strong>. All contributors will get the same environment!
                </p>
              </div>

              <div class="bg-muted/50 rounded-lg p-4 mt-6">
                <h4 class="font-semibold mb-2">Future Enhancement</h4>
                <p class="text-sm text-muted-foreground mb-2">
                  Once <a href="https://github.com/devcontainers/spec/issues/22" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">devcontainer extension</a> is supported, you'll be able to simply extend the configuration:
                </p>
                <CodeBlock
                  code={`{
  "name": "My Project",
  "extends": ".devcontainer/devcontainer.json"
}`}
                  lang="json"
                  class="text-xs"
                />
                <p class="text-sm text-muted-foreground mt-2">
                  But don't hold your breath... the issue is from 2022.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Maintainer Tab -->
        <div class="tab-content hidden" data-content="maintainer">
          <div class="bg-card border border-border rounded-lg p-8">
            <div class="mb-6">
              <h2 class="text-3xl font-bold mb-3">Maintainer Mode</h2>
              <p class="text-lg text-muted-foreground">
                Develop DevMagic itself (including this website in the <code>www/</code> folder) using its own Dev Container. Self-hosting at its finest!
              </p>
            </div>

            <div class="space-y-6">
              <div>
                <h3 class="text-xl font-semibold mb-3">Step 1: Clone for Development</h3>
                <CodeBlock
                  code={`git clone https://github.com/marcelocra/devmagic.git
cd devmagic`}
                />
              </div>

              <div>
                <h3 class="text-xl font-semibold mb-3">Step 2: Reopen in Container</h3>
                <p class="mb-2">
                  A wrapper <code>.devcontainer/devcontainer.json</code> file is included at the root level. VS Code will detect it and allow you to <strong>"Reopen in Container"</strong>.
                </p>
              </div>

              <div>
                <h3 class="text-xl font-semibold mb-3">Step 3: Start Developing</h3>
                <p class="mb-2">This setup ensures:</p>
                <ul class="space-y-2 text-muted-foreground">
                  <li class="flex items-start gap-2">
                    <span class="text-primary">✓</span>
                    <strong>Consumers</strong> see the expected <code>.devcontainer/</code> contents when using this repo as a submodule
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-primary">✓</span>
                    <strong>Maintainers</strong> can work on DevMagic itself in a self-hosted Dev Container
                  </li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold mb-3">Working on the Website</h3>
                <p class="mb-2">To develop the website (this site you're viewing):</p>
                <CodeBlock
                  code={`cd www
npm install
npm run dev`}
                />
                <p class="mt-2 text-sm text-muted-foreground">
                  The site will be available at <code>http://localhost:4321</code>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Next Steps -->
      <section class="mt-12 bg-primary/5 rounded-lg p-6">
        <h2 class="text-2xl font-bold mb-4">Next Steps</h2>
        <ul class="space-y-3">
          <li>
            <a href="/docs" class="text-primary hover:underline font-medium">
              Read the documentation →
            </a>
            <p class="text-sm text-muted-foreground">Learn about auxiliary services, customization, and how it all works</p>
          </li>
          <li>
            <a href="/features" class="text-primary hover:underline font-medium">
              Explore features →
            </a>
            <p class="text-sm text-muted-foreground">See what makes DevMagic powerful and flexible</p>
          </li>
          <li>
            <a href="https://github.com/marcelocra/devmagic/issues" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline font-medium">
              Get help or contribute →
            </a>
            <p class="text-sm text-muted-foreground">Join the community, report issues, or contribute improvements</p>
          </li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  function initTabs() {
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabContents = document.querySelectorAll('.tab-content');

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const tabName = button.getAttribute('data-tab');

        // Update buttons
        tabButtons.forEach((btn) => {
          btn.classList.remove('active', 'border-primary', 'text-foreground');
          btn.classList.add('text-muted-foreground');
        });
        button.classList.add('active', 'border-primary', 'text-foreground');
        button.classList.remove('text-muted-foreground');

        // Update content
        tabContents.forEach((content) => {
          if (content.getAttribute('data-content') === tabName) {
            content.classList.remove('hidden');
          } else {
            content.classList.add('hidden');
          }
        });
      });
    });

    // Set initial state
    const firstButton = tabButtons[0];
    if (firstButton) {
      firstButton.classList.add('border-primary', 'text-foreground');
      firstButton.classList.remove('text-muted-foreground');
    }
  }

  initTabs();
  document.addEventListener('astro:page-load', initTabs);
</script>

<style>
  .tab-button.active {
    color: var(--color-foreground);
    border-color: var(--color-primary);
  }
</style>
